# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# Google Workspace & Email Routing Configuration
# ==============================================================================
# Official company mailbox for LINCS Sparkling Cleaning Services Ltd.
# All customer quote requests, commercial booking inquiries, and fast messages
# are routed to this address with Google Workspace deliverability headers.
GOOGLE_WORKSPACE_EMAIL="info@lincsscsltd.com"
DISPATCH_EMAIL="info@lincsscsltd.com"

# OPTION 1: Google Workspace Direct SMTP (Recommended for Google Workspace accounts)
# 1. Enable 2-Step Verification in Google Workspace Account (info@lincsscsltd.com)
# 2. Generate a 16-character App Password under Google Account -> Security -> App Passwords
# 3. Paste the 16-character App Password below:
GOOGLE_WORKSPACE_APP_PASSWORD=""
# Optional relay host (default is smtp.gmail.com):
GOOGLE_WORKSPACE_RELAY_HOST="smtp.gmail.com"

# OPTION 2: Standard SMTP Relay or third-party email provider
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LINCS Sparkilng Cleaning Services LTD <info@lincsscsltd.com>"

# ==============================================================================
# Cloudflare Worker & Email Sending Variables
# (Configure in Cloudflare Dashboard -> Workers & Pages -> Settings -> Variables and Secrets)
# Or via: npx wrangler secret put CF_EMAIL_API_TOKEN
# ==============================================================================
# Cloudflare Account ID (Dashboard URL or Workers overview)
CF_EMAIL_ACCOUNT_ID="your_cloudflare_account_id"

# Cloudflare API Token with "Email Sending: Edit" permissions (SECRET)
CF_EMAIL_API_TOKEN="your_cloudflare_api_token"

# Destination inbox (defaults to info@lincsscsltd.com)
DISPATCH_EMAIL="info@lincsscsltd.com"

# Verified sender address on lincsscsltd.com (defaults to website@lincsscsltd.com)
EMAIL_FROM="website@lincsscsltd.com"
